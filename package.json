{
  "name": "portfolio-2025-partage",
  "version": "1.2.0",
  "description": "Code commun à portfolio-2025-back et portfolio-2025-front : contrats de l'API des formations, modèles de l'API, moteur de formules, lecture d'un nombre saisi, échappement HTML, statut d'un score, gardes de valeurs, garde des commentaires et outils de test des portes.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimMoyence/portfolio-2025-partage.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "outils"
  ],
  "bin": {
    "garde-commentaires": "outils/garde-commentaires/cli.mjs"
  },
  "exports": {
    "./api": {
      "import": {
        "types": "./dist/esm/api.d.ts",
        "default": "./dist/esm/api.js"
      },
      "require": {
        "types": "./dist/cjs/api.d.ts",
        "default": "./dist/cjs/api.js"
      }
    },
    "./contrats": {
      "import": {
        "types": "./dist/esm/contrats.d.ts",
        "default": "./dist/esm/contrats.js"
      },
      "require": {
        "types": "./dist/cjs/contrats.d.ts",
        "default": "./dist/cjs/contrats.js"
      }
    },
    "./formule": {
      "import": {
        "types": "./dist/esm/formule.d.ts",
        "default": "./dist/esm/formule.js"
      },
      "require": {
        "types": "./dist/cjs/formule.d.ts",
        "default": "./dist/cjs/formule.js"
      }
    },
    "./html": {
      "import": {
        "types": "./dist/esm/html.d.ts",
        "default": "./dist/esm/html.js"
      },
      "require": {
        "types": "./dist/cjs/html.d.ts",
        "default": "./dist/cjs/html.js"
      }
    },
    "./score": {
      "import": {
        "types": "./dist/esm/score.d.ts",
        "default": "./dist/esm/score.js"
      },
      "require": {
        "types": "./dist/cjs/score.d.ts",
        "default": "./dist/cjs/score.js"
      }
    },
    "./valeurs": {
      "import": {
        "types": "./dist/esm/valeurs.d.ts",
        "default": "./dist/esm/valeurs.js"
      },
      "require": {
        "types": "./dist/cjs/valeurs.d.ts",
        "default": "./dist/cjs/valeurs.js"
      }
    },
    "./outils/depot": {
      "import": {
        "types": "./dist/outils/depot.d.mts",
        "default": "./outils/depot.mjs"
      }
    },
    "./outils/dossier-temporaire": {
      "import": {
        "types": "./dist/outils/dossier-temporaire.d.mts",
        "default": "./outils/dossier-temporaire.mjs"
      }
    },
    "./outils/porte-de-duplication": {
      "import": {
        "types": "./dist/outils/porte-de-duplication.d.mts",
        "default": "./outils/porte-de-duplication.mjs"
      }
    },
    "./outils/workflow-github": {
      "import": {
        "types": "./dist/outils/workflow-github.d.mts",
        "default": "./outils/workflow-github.mjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "api": [
        "dist/cjs/api.d.ts"
      ],
      "contrats": [
        "dist/cjs/contrats.d.ts"
      ],
      "formule": [
        "dist/cjs/formule.d.ts"
      ],
      "html": [
        "dist/cjs/html.d.ts"
      ],
      "score": [
        "dist/cjs/score.d.ts"
      ],
      "valeurs": [
        "dist/cjs/valeurs.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/construire.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "verifier:paquet": "node scripts/verifier-paquet.mjs",
    "guard:comments": "node outils/garde-commentaires/cli.mjs --root .",
    "guard:comments:count": "node outils/garde-commentaires/cli.mjs --root . --count",
    "guard:comments:tighten": "node outils/garde-commentaires/cli.mjs --root . --tighten",
    "ci:check": "npm run typecheck && npm run format:check && npm run guard:comments && npm test && npm run build && npm run verifier:paquet"
  },
  "guard-no-comments": {
    "maxOffenses": 0,
    "perimetre": [
      "src/",
      "test/",
      "scripts/",
      "outils/"
    ]
  },
  "peerDependencies": {
    "typescript": ">=5.7.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "fast-check": "^4.6.0",
    "prettier": "^3.6.2",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4"
  }
}
